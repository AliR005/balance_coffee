{
  "openapi": "3.1.0",
  "info": {
    "title": "Balance API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/locations": {
      "get": {
        "tags": [
          "locations"
        ],
        "summary": " List Locations",
        "operationId": "_list_locations_locations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LocationOut"
                  },
                  "type": "array",
                  "title": "Response  List Locations Locations Get"
                }
              }
            }
          }
        }
      }
    },
    "/locations/{location_id}/menu": {
      "get": {
        "tags": [
          "locations"
        ],
        "summary": " Get Menu",
        "operationId": "_get_menu_locations__location_id__menu_get",
        "parameters": [
          {
            "name": "location_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Location Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/locations/{location_id}/quote": {
      "post": {
        "tags": [
          "locations"
        ],
        "summary": " Quote",
        "operationId": "_quote_locations__location_id__quote_post",
        "parameters": [
          {
            "name": "location_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Location Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/db-check": {
      "get": {
        "summary": " Db Check",
        "operationId": "_db_check_db_check_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response  Db Check Db Check Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductOut"
            },
            "type": "array",
            "title": "Products",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name"
        ],
        "title": "CategoryOut"
      },
      "GroupOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "min_select": {
            "type": "integer",
            "title": "Min Select"
          },
          "max_select": {
            "type": "integer",
            "title": "Max Select"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "default_option_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Default Option Ids",
            "default": []
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/OptionOut"
            },
            "type": "array",
            "title": "Options",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "key",
          "name",
          "min_select",
          "max_select",
          "required"
        ],
        "title": "GroupOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocationOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "address": {
            "type": "string",
            "title": "Address",
            "default": ""
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "is_open_now": {
            "type": "boolean",
            "title": "Is Open Now"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "timezone",
          "is_open_now"
        ],
        "title": "LocationOut"
      },
      "MenuOut": {
        "properties": {
          "location_id": {
            "type": "integer",
            "title": "Location Id"
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategoryOut"
            },
            "type": "array",
            "title": "Categories",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "location_id"
        ],
        "title": "MenuOut"
      },
      "OptionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "price_delta": {
            "type": "integer",
            "title": "Price Delta"
          },
          "visual": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visual"
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "price_delta"
        ],
        "title": "OptionOut"
      },
      "ProductOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "base_price": {
            "type": "integer",
            "title": "Base Price"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url",
            "default": ""
          },
          "video_url": {
            "type": "string",
            "title": "Video Url",
            "default": ""
          },
          "poster_url": {
            "type": "string",
            "title": "Poster Url",
            "default": ""
          },
          "video_duration_sec": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Duration Sec"
          },
          "video_steps": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Steps"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "default": []
          },
          "prep_units": {
            "type": "integer",
            "title": "Prep Units",
            "default": 1
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "default": true
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/GroupOut"
            },
            "type": "array",
            "title": "Groups",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "base_price"
        ],
        "title": "ProductOut"
      },
      "QuoteIn": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/QuoteItemIn"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "QuoteIn"
      },
      "QuoteItemIn": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "option_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Option Ids"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "product_id"
        ],
        "title": "QuoteItemIn"
      },
      "QuoteLineOut": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "integer",
            "title": "Unit Price"
          },
          "line_total": {
            "type": "integer",
            "title": "Line Total"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "quantity",
          "unit_price",
          "line_total"
        ],
        "title": "QuoteLineOut"
      },
      "QuoteOut": {
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/QuoteLineOut"
            },
            "type": "array",
            "title": "Lines"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "lines",
          "total",
          "currency"
        ],
        "title": "QuoteOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
